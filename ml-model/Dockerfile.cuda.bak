FROM pytorch/pytorch:2.2.0-cuda11.8-cudnn8-runtime

WORKDIR /app

# Default runtime settings for the local Hugging Face LLM.
# Keep secrets like HUGGINGFACE_HUB_TOKEN out of the image; pass them at runtime.
ENV MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct \
  USE_HF_LLM=true \
  HF_LOAD_IN_4BIT=true

# Install system dependencies needed for building Python packages and bitsandbytes
RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  git \
  build-essential \
  libgomp1 \
  libopenblas-dev \
  libomp-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt ./
# Upgrade pip and install Python deps. Base image already includes CUDA-enabled PyTorch.
RUN pip install --upgrade pip setuptools wheel && pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app ./app

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# Run as non-root user
RUN useradd -m -u 1001 python_user && chown -R python_user:python_user /app
USER python_user

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
