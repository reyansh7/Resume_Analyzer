# ⚠️ IMPORTANT: Use separate .env files for frontend and backend - see README.md
# This is a reference only. Copy this to backend/.env and frontend/.env.local

# === FRONTEND (.env.local) ===
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api

# === BACKEND (.env) ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resume_analyzer
NODE_ENV=development

# JWT Secret (MUST be 32+ characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=9487c8c2c33dffc41f426afe8005996bc8bc341f63b3eda26522e95e1a5ca119
JWT_EXPIRES_IN=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Resume Text Storage
STORE_RAW_RESUME_TEXT=false
RESUME_TEXT_MAX_CHARS=4000

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Gemini API (optional - required if USE_GEMINI_ROADMAP=true)
USE_GEMINI_ROADMAP=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=8000
GEMINI_MAX_RETRIES=1
