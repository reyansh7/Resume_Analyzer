PORT=8080
NODE_ENV=development

# Prisma runtime DB URL (set this to Transaction pooler URL when using Supabase pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# Prisma direct DB URL (used for migrations/introspection)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

JWT_SECRET=change_me_securely
JWT_EXPIRES_IN=1d
JWT_COOKIE_NAME=access_token
CORS_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://ml-model:8000
USE_IN_MEMORY_DB=false
